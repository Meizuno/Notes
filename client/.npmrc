# pnpm truncates the directory names under node_modules/.pnpm to this many
# characters. The default differs per platform (60 on Windows, 120 elsewhere),
# and those paths are written into the generated auto-imports.d.ts /
# components.d.ts — so without pinning it, the two files churn in git whenever
# the project is installed on a different OS than the last person used.
virtual-store-dir-max-length=60
